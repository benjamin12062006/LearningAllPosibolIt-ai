# Servicio de IA de KTSU (plan 01 del servicio, «Configuración»).
# Copia este archivo a .env. Las variables del proceso ganan a las del archivo.

# Solo local: nadie de la red alcanza el servicio.
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8090

# Obligatorio, 32+ caracteres. Genera uno con `make token` y pon el mismo valor
# en AI_SERVICE_TOKEN del .env de la API Nest.
AI_SERVICE_TOKEN=

# Qdrant de desarrollo (`make qdrant-up`). La clave solo para un Qdrant remoto.
QDRANT_URL=http://127.0.0.1:56333
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=5

LOG_LEVEL=INFO

# Conocimiento en Qdrant (plan E6, E6.1).
KNOWLEDGE_COLLECTION=ktsu_knowledge

# Colección derivada de descripciones de herramientas y URL del contrato E6.3a.
# Solo se usan cuando bootstrap recibe un modelo de chat.
AGENT_TOOLS_COLLECTION=ktsu_agent_tools
NEST_AGENT_BASE_URL=

# Embeddings de Google por Vertex AI, con las credenciales de la cuenta
# (`gcloud auth application-default login`); sin clave de API. Cambiar el modelo
# o las dimensiones obliga a reindexar.
GOOGLE_CLOUD_PROJECT=estadistica-forms-api
GOOGLE_CLOUD_LOCATION=us-central1
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CONCURRENCY=4
EMBEDDING_TIMEOUT_SECONDS=60
